# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database (Neon)
# connect_timeout/connection_limit/pool_timeout: Neon's serverless compute suspends after
# idle periods, so the first query after a gap can hit a cold start. connect_timeout=15
# and pool_timeout=15 give that cold start room to finish before Prisma gives up trying to
# open/borrow a connection (Neon's own default connect_timeout is 5s). connection_limit=20
# matches Neon's own worked example for Prisma + their pooled endpoint. Do NOT add
# pgbouncer=true — that flag is for PgBouncer < 1.21.0; Neon runs 1.22.0+, and Prisma's
# docs say not to set it on newer PgBouncer versions.
DATABASE_URL=postgresql://user:password@host/chronoloop?sslmode=require&connect_timeout=15&connection_limit=20&pool_timeout=15
DATABASE_URL_TEST=postgresql://user:password@host/chronoloop-test?sslmode=require&connect_timeout=15&connection_limit=20&pool_timeout=15

# Auth
JWT_ACCESS_SECRET=change-me-32-bytes-min
JWT_REFRESH_SECRET=change-me-different-32-bytes-min
COOKIE_DOMAIN=localhost
